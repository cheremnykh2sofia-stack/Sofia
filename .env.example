# Claude Code SuperConfig - Environment Variables
# Copy this file to .env and fill in your API keys

# ============================================
# AI MODELS
# ============================================

# Anthropic Claude (required for Claude Code)
ANTHROPIC_API_KEY=your-anthropic-api-key-here

# OpenAI (optional)
OPENAI_API_KEY=your-openai-api-key-here

# Google Gemini (for image generation, text, video)
GEMINI_API_KEY=your-gemini-api-key-here

# Kimi (for deep reasoning, 262K context)
KIMI_API_KEY=your-kimi-api-key-here

# DeepSeek (for code generation)
DEEPSEEK_API_KEY=your-deepseek-api-key-here

# Perplexity AI (for research with web search)
PERPLEXITY_API_KEY=your-perplexity-api-key-here

# ============================================
# MEDIA GENERATION
# ============================================

# ElevenLabs (text-to-speech)
ELEVENLABS_API_KEY=your-elevenlabs-api-key-here

# HeyGen (AI avatar videos)
HEYGEN_API_KEY=your-heygen-api-key-here

# D-ID (talking avatars from photos)
DID_API_KEY=your-did-api-key-here

# Deepgram (speech-to-text)
DEEPGRAM_API_KEY=your-deepgram-api-key-here

# Submagic (AI subtitles)
SUBMAGIC_API_KEY=your-submagic-api-key-here

# Replicate (1000+ AI models)
REPLICATE_API_KEY=your-replicate-api-key-here

# ============================================
# INTEGRATIONS (MCP Servers)
# ============================================

# GitHub (repos, issues, PRs)
GITHUB_TOKEN=your-github-token-here

# Linear (project management)
LINEAR_API_KEY=your-linear-api-key-here

# Slack (team communication)
SLACK_BOT_TOKEN=your-slack-bot-token-here
SLACK_TEAM_ID=your-slack-team-id-here

# Notion (documentation, knowledge base)
NOTION_API_KEY=your-notion-api-key-here

# Sentry (error monitoring)
SENTRY_AUTH_TOKEN=your-sentry-auth-token-here
SENTRY_ORG=your-sentry-org-here

# Figma (design files)
FIGMA_ACCESS_TOKEN=your-figma-access-token-here

# ============================================
# SEARCH & RESEARCH
# ============================================

# SerpAPI (Google search results)
SERPAPI_API_KEY=your-serpapi-api-key-here

# ============================================
# TELEGRAM BOT (if applicable)
# ============================================

# Telegram Bot Token
BOT_TOKEN=your-telegram-bot-token-here

# ============================================
# DATABASE
# ============================================

# PostgreSQL (if using)
DATABASE_URL=postgresql://user:password@localhost:5432/dbname

# MongoDB (if using)
MONGODB_URI=mongodb://localhost:27017/dbname

# Redis (if using)
REDIS_URL=redis://localhost:6379/0

# ============================================
# DEPLOYMENT
# ============================================

# Docker Registry (if using private registry)
DOCKER_REGISTRY_USER=your-registry-user
DOCKER_REGISTRY_PASSWORD=your-registry-password

# AWS (if using)
AWS_ACCESS_KEY_ID=your-aws-access-key
AWS_SECRET_ACCESS_KEY=your-aws-secret-key
AWS_REGION=us-east-1

# ============================================
# NOTES
# ============================================

# Most API keys can be obtained from:
# - Anthropic: https://console.anthropic.com/
# - Gemini: https://ai.google.dev/
# - GitHub: https://github.com/settings/tokens
# - Linear: https://linear.app/settings/api
# - Slack: https://api.slack.com/apps
# - Notion: https://www.notion.so/my-integrations
# - ElevenLabs: https://elevenlabs.io/
# - Perplexity: https://www.perplexity.ai/settings/api

# Keep this file secure and never commit it to version control!
# Add .env to your .gitignore file.
